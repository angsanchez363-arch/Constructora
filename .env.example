# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# Todos los valores de abajo son FICTICIOS.

# --- Aplicación (API) ---
# Secreto. Cadena de conexión a PostgreSQL. Cambiar esta línea es el "corte" de la migración.
DATABASE_URL=postgresql://constructora:cambia-esta-clave@db:5432/constructora
# true en bases gestionadas (Neon, Supabase), que exigen conexión cifrada
DB_SSL=false
PORT=8000
APP_VERSION=1.0.0

# --- PostgreSQL local (solo para deploy/compose.prod.yaml) ---
# Secreto. Debe coincidir con la clave usada en DATABASE_URL.
POSTGRES_USER=constructora
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=constructora

# --- Migración (scripts/migrar.sh) ---
# Secreto. Cadena del destino gestionado. Se pasa por la terminal, no se guarda aquí:
# NUBE_URL=postgresql://usuario:clave@ep-ejemplo.neon.tech/constructora?sslmode=require
