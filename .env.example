# Copia este archivo a .env (chmod 640, dueño root:despliegue en el servidor).
# NUNCA subas .env al repositorio. Todos los valores de abajo son FICTICIOS: reemplaza cada
# "cambia-..." por una clave aleatoria (openssl rand -hex 24). Usa solo letras y números en las
# claves: van dentro de las cadenas de conexión (URL).

# --- Aplicación (API) ---
# Secreto. La API se conecta con el rol de MÍNIMO privilegio (sin DDL). Debe coincidir con APP_PASSWORD.
DATABASE_URL=postgresql://constructora_app:cambia-app@db:5432/constructora
# Secreto. Solo para el servicio "migrar": rol DUEÑO de las tablas. Debe coincidir con OWNER_PASSWORD.
MIGRATION_DATABASE_URL=postgresql://constructora_owner:cambia-owner@db:5432/constructora
# true en bases gestionadas (Neon, Supabase), que exigen conexión cifrada
DB_SSL=false
PORT=8000
APP_VERSION=1.0.0

# --- PostgreSQL local (solo para deploy/compose.prod.yaml) ---
# POSTGRES_USER/PASSWORD: administrador de la base. Solo para administrar; la app NUNCA lo usa.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-admin
POSTGRES_DB=constructora
# Contraseñas de los roles de la base (las aplica scripts/aplicar-roles.sh)
OWNER_PASSWORD=cambia-owner
APP_PASSWORD=cambia-app
RESPALDO_PASSWORD=cambia-respaldo
# Puerto del host (solo 127.0.0.1) por donde el respaldo hace pg_dump
DB_HOST_PORT=5432

# --- Migración a la nube (scripts/migrar.sh) ---
# Secreto. Cadena del destino gestionado. Se pasa por la terminal, no se guarda aquí:
# NUBE_URL=postgresql://usuario:clave@ep-ejemplo.neon.tech/constructora?sslmode=require
